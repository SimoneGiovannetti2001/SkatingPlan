<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.skatingplan.controllergrafici1.PagaControllerG">
   <ImageView fitHeight="720.0" fitWidth="1280.0" pickOnBounds="true" preserveRatio="true">
      <Image url="@../image/Scelta.jpg" />
   </ImageView>
   <Label layoutX="11.0" layoutY="1.0" text="SkatingPlan" textFill="#000066">
      <font>
         <Font size="55.0" />
      </font>
   </Label>
   <Button fx:id="home" layoutX="1203.0" layoutY="7.0" mnemonicParsing="false" onAction="#onHomeClick" prefHeight="70.0" prefWidth="70.0" style="-fx-background-color: white;">
      <graphic>
         <ImageView fitHeight="60.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true">
            <Image url="@../image/account.png" />
         </ImageView>
      </graphic>
   </Button>
   <Button fx:id="pagaAllaLezione" layoutX="300.0" layoutY="285.0" mnemonicParsing="false" onAction="#onPagaAllaLezione" prefHeight="150.0" prefWidth="250.0" style="-fx-background-color: #38bdf8;" text="Paga alla lezione" textFill="#000066">
      <font>
         <Font size="25.0" />
      </font>
   </Button>
   <Button fx:id="pagaOnline" layoutX="730.0" layoutY="285.0" mnemonicParsing="false" onAction="#onPagaOnline" prefHeight="150.0" prefWidth="250.0" style="-fx-background-color: #38bdf8;" text="Paga online" textFill="#000066">
      <font>
         <Font size="25.0" />
      </font>
   </Button>
   <Label fx:id="erroriLabel" layoutX="490.0" layoutY="160.0" maxHeight="50.0" maxWidth="300.0" minHeight="50.0" minWidth="300.0" prefHeight="50.0" prefWidth="300.0">
      <font>
         <Font size="20.0" />
      </font>
   </Label>
</AnchorPane>
